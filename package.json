{
  "name": "design-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build:tokens": "tsx tokens/build.ts",
    "build:registry": "tsx scripts/build-registry.ts",
    "generate": "pnpm build:tokens && pnpm build:registry",
    "build:cli": "pnpm --filter @ds/cli build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:generated": "tsx tokens/build.ts --check && tsx scripts/build-registry.ts --check",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:generated"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@ds/core": "workspace:^",
    "@eslint/js": "^10.0.1",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/stylex": "^0.19.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
